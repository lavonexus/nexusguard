# Production ortam değişkenleri şablonu. Gerçek değerlerle ".env.prod" adında bir kopyasını
# oluştur (docker-compose.prod.yml varsayılan olarak bu dosyayı okur) ve ASLA repoya ekleme.

# GoDaddy'den alınan domain, DNS A kaydı sunucunun IP'sine işaret etmeli.
DOMAIN=nexusguard.xx
API_DOMAIN=api.nexusguard.xx

# Güçlü, rastgele bir şifre üret (örn. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Discord Developer Portal > OAuth2 (mevcut uygulamana production redirect URI'sini
# https://api.nexusguard.xx/api/auth/discord/callback olarak ekle, localhost'u silme).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google Cloud Console > Credentials (mevcut OAuth client'a production redirect URI'sini
# https://api.nexusguard.xx/api/auth/google/callback olarak ekle, localhost'u silme).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yapay zeka risk özetleri için Anthropic API anahtarı.
ANTHROPIC_API_KEY=

# Bu e-postayla Google ile giriş yapan hesap otomatik olarak site yöneticisi olur.
ADMIN_BOOTSTRAP_EMAIL=lavoyeralti@gmail.com
